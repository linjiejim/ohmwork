{
 "voice": "Chinese (Mandarin)_Sincere_Adult",
 "speed": 1.0,
 "lead": 0.9,
 "gap": 0.5,
 "tail": 1.6,
 "lines": [
  {
   "id": "intro",
   "text": "温度是测得最多的物理量，最便宜的办法，是一只热敏电阻。",
   "beats": {
    "therm": "热敏电阻"
   },
   "gapAfter": 0.7
  },
  {
   "id": "ntc",
   "text": "温度越高，它的阻值越小，这一类叫 NTC。",
   "beats": {
    "hot": "越高",
    "low": "越小",
    "ntcw": "NTC"
   },
   "gapAfter": 0.7
  },
  {
   "id": "curve",
   "text": "阻值不是直线：零下二十度有一百多千欧，一百度只剩七百欧。",
   "caption": "阻值不是直线：−20 °C 时 100 多 kΩ，100 °C 只剩约 700 Ω。",
   "beats": {
    "c1": "零下二十度",
    "c2": "一百度"
   },
   "gapAfter": 0.7
  },
  {
   "id": "log",
   "text": "差了一百五十倍，所以画图时，纵轴要取对数。",
   "beats": {
    "times": "一百五十倍",
    "logw": "对数"
   },
   "gapAfter": 0.8
  },
  {
   "id": "div",
   "text": "单片机读不了电阻，就把它和固定电阻串起来分压，读中点电压。",
   "beats": {
    "divw": "分压",
    "mid": "中点"
   },
   "gapAfter": 0.7
  },
  {
   "id": "pick",
   "text": "固定电阻取多大？取关心的温度下，它自己的阻值，那里最灵敏。",
   "beats": {
    "pickw": "取多大",
    "steep": "最灵敏"
   },
   "gapAfter": 0.7
  },
  {
   "id": "self",
   "text": "还要当心自热：电流流过它会发热，读数就偏高。",
   "beats": {
    "selfw": "自热"
   },
   "gapAfter": 0.8
  },
  {
   "id": "chip",
   "text": "不想算公式，就用数字温度芯片，一根线就能读，精度半度。",
   "caption": "不想算公式，就用数字温度芯片（DS18B20），一根线就能读，精度 ±0.5 °C。",
   "beats": {
    "chipw": "数字温度芯片",
    "wire": "一根线"
   },
   "gapAfter": 0.7
  },
  {
   "id": "hi",
   "text": "上千度的炉子用热电偶，要精密，就用铂电阻。",
   "beats": {
    "tc": "热电偶",
    "pt": "铂电阻"
   },
   "gapAfter": 0.8
  },
  {
   "id": "outro",
   "text": "下面的实验里，拖动温度，看分压怎么变。",
   "beats": {
    "try": "拖动"
   }
  }
 ],
