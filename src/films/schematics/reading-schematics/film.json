  "tail": 1.6,
  "lines": [
    { "id": "intro", "text": "认得符号，还不等于读得懂图。这一课讲怎么读一张完整的原理图。", "gapAfter": 0.6 },
    { "id": "conn", "text": "原理图只画谁和谁相连，不画它们在板子上的位置。", "beats": { "links": "相连", "pos": "位置" }, "gapAfter": 0.7 },
    { "id": "label", "text": "两个点隔得远，不用画线，贴上同样的网络标号，就连在一起了。", "beats": { "far": "隔得远", "lab": "网络标号", "join": "连在一起" }, "gapAfter": 0.7 },
    { "id": "cross", "text": "两根线交叉，有圆点才相连；没有圆点，只是从上面跨过去。", "beats": { "dot": "圆点", "nodot": "没有圆点" }, "gapAfter": 0.7 },
    { "id": "order", "text": "读图有个顺序：先看电源，再看地，然后是主芯片。", "beats": { "pwr": "电源", "gnd": "地", "mcu": "主芯片" }, "gapAfter": 0.6 },
    { "id": "io", "text": "接着看输入和输出，最后看它用什么通信。", "beats": { "in": "输入", "out": "输出", "comm": "通信" }, "gapAfter": 0.7 },
    { "id": "habit", "text": "习惯上，信号从左进、右出，电源在上，地在下。", "beats": { "lr": "左进", "up": "电源在上" }, "gapAfter": 0.7 },
    { "id": "bom", "text": "图上的位号，对应物料清单里的一行，也对应电路板丝印上的一个位置。", "beats": { "ref": "位号", "bomRow": "物料清单", "pcb": "丝印" }, "gapAfter": 0.7 },
    { "id": "outro", "text": "下面这块小板子，一步步走一遍，再选 SDA，看那根没画的线。", "beats": { "walk": "走一遍", "sda": "SDA" } }
  ],
