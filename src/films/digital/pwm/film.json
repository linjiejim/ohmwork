{
  "voice": "Chinese (Mandarin)_Sincere_Adult",
  "speed": 1.0,
  "lead": 0.9,
  "gap": 0.5,
  "tail": 1.6,
  "lines": [
    {
      "id": "intro",
      "text": "单片机的引脚只有高和低两种电平，怎么让灯只亮一半？",
      "gapAfter": 0.7
    },
    {
      "id": "fastL",
      "text": "办法是飞快地开、关、开、关。",
      "beats": {
        "fast": "飞快",
        "blink": "开、关"
      },
      "gapAfter": 0.7
    },
    {
      "id": "dutyL",
      "text": "一个周期里，开着的时间占的比例，叫占空比。",
      "beats": {
        "period": "一个周期",
        "on": "开着",
        "duty": "占空比"
      },
      "gapAfter": 0.7
    },
    {
      "id": "avgL",
      "text": "占空比越大，平均电压越高：百分之三十，就是一点五伏。",
      "caption": "占空比越大，平均电压越高：30%，就是 1.5 V。",
      "beats": {
        "bigger": "越大",
        "d30": "百分之三十",
        "v15": "一点五伏"
      },
      "gapAfter": 0.8
    },
    {
      "id": "eff",
      "text": "用电阻降压，多余的电白白变成热；开关只有通和断，几乎不发热。",
      "beats": {
        "res": "电阻降压",
        "sw": "开关"
      },
      "gapAfter": 0.8
    },
    {
      "id": "freq",
      "text": "频率也要选对：调光要几百赫兹以上，电机要二十千赫以上，人耳才听不到。",
      "caption": "频率也要选对：调光要几百 Hz 以上，电机要 20 kHz 以上，人耳才听不到。",
      "beats": {
        "led": "调光",
        "motor": "电机",
        "ear": "人耳"
      },
      "gapAfter": 0.8
    },
    {
      "id": "servoL",
      "text": "舵机看的是脉冲本身的宽度：一毫秒转到一端，两毫秒转到另一端。",
      "caption": "舵机看的是脉冲本身的宽度：1 ms 转到一端，2 ms 转到另一端。",
      "beats": {
        "servo": "舵机",
        "ms1": "一毫秒",
        "ms2": "两毫秒"
      },
      "gapAfter": 0.8
    },
    {
      "id": "drive",
      "text": "负载电流大，引脚带不动，就交给一只场效应管去开关。",
      "caption": "负载电流大，引脚带不动，就交给一只 MOSFET 去开关。",
      "beats": {
        "big": "带不动",
        "fet": "场效应管"
      },
      "gapAfter": 0.8
    },
    {
      "id": "rc",
      "text": "后面接一级低通滤波，开关的抖动被抹平，剩下的就是平均电压。",
      "beats": {
        "lp": "低通滤波",
        "smooth": "抹平",
        "mean": "平均电压"
      },
      "gapAfter": 0.8
    },
    {
      "id": "outro",
      "text": "下面，拖动占空比，看亮度和平均电压怎么变。",
      "beats": {
        "drag": "拖动"
      }
    }
  ],
