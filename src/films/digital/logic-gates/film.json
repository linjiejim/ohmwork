{
  "voice": "Chinese (Mandarin)_Sincere_Adult",
  "speed": 1.0,
  "lead": 0.9,
  "gap": 0.5,
  "tail": 1.6,
  "lines": [
    {
      "id": "intro",
      "text": "这一课讲数字电路最基础的两样东西：高低电平，和逻辑门。",
      "gapAfter": 0.7
    },
    {
      "id": "ana",
      "text": "模拟信号的电压可以取任意值，一点噪声，就会改变它的样子。",
      "beats": {
        "any": "任意值",
        "noise": "噪声"
      },
      "gapAfter": 0.7
    },
    {
      "id": "dig",
      "text": "数字信号只约定两种状态：高是一，低是零。",
      "caption": "数字信号只约定两种状态：高是 1，低是 0。",
      "beats": {
        "hi": "高",
        "one": "一",
        "lo": "低",
        "zero": "零"
      },
      "gapAfter": 0.7
    },
    {
      "id": "regen",
      "text": "噪声再大，只要没越过门槛，接收方照样认得，再输出干净的信号。",
      "beats": {
        "noise2": "噪声",
        "thr": "门槛",
        "clean": "干净"
      },
      "gapAfter": 0.8
    },
    {
      "id": "gateL",
      "text": "逻辑门按固定规则，把输入变成输出。规则列成表，叫真值表。",
      "beats": {
        "gate": "逻辑门",
        "rule": "固定规则",
        "table": "真值表"
      },
      "gapAfter": 0.8
    },
    {
      "id": "andL",
      "text": "与门：两个输入都是一，输出才是一。",
      "caption": "与门：两个输入都是 1，输出才是 1。",
      "beats": {
        "and": "与门",
        "both": "都是一"
      },
      "gapAfter": 0.7
    },
    {
      "id": "orL",
      "text": "或门：只要有一个输入是一，输出就是一。",
      "caption": "或门：只要有一个输入是 1，输出就是 1。",
      "beats": {
        "or": "或门",
        "or1": "就是一"
      },
      "gapAfter": 0.7
    },
    {
      "id": "notL",
      "text": "非门只有一个输入，输出和它正相反。",
      "beats": {
        "not": "非门",
        "inv": "正相反"
      },
      "gapAfter": 0.7
    },
    {
      "id": "xorL",
      "text": "异或门：两个输入不一样，输出才是一。",
      "caption": "异或门：两个输入不一样，输出才是 1。",
      "beats": {
        "xor": "异或门",
        "xor1": "才是一"
      },
      "gapAfter": 0.8
    },
    {
      "id": "nandL",
      "text": "只用与非门，就能搭出所有别的门，所以它叫万能门。",
      "beats": {
        "nand": "与非门",
        "all": "所有",
        "univ": "万能门"
      },
      "gapAfter": 0.8
    },
    {
      "id": "outro",
      "text": "下面，把七种门挨个试一遍，看真值表怎么变。",
      "beats": {
        "try": "挨个试"
      }
    }
  ],
