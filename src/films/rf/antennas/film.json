{
  "voice": "Chinese (Mandarin)_Sincere_Adult",
  "speed": 1,
  "lead": 0.9,
  "gap": 0.5,
  "tail": 1.6,
  "lines": [
    {
      "id": "intro",
      "text": "天线，是电路和空间之间的接口：把电流变成电磁波。",
      "gapAfter": 0.6
    },
    {
      "id": "dipole",
      "text": "把导线的末端向两边掰开，就成了最简单的天线：偶极子。",
      "gapAfter": 0.7,
      "beats": {
        "open": "掰开",
        "dip": "偶极子"
      }
    },
    {
      "id": "standing",
      "text": "电流冲到尽头被反弹回来，叠成驻波：两端为零，中间最大。",
      "gapAfter": 0.8,
      "beats": {
        "refl": "反弹",
        "mid": "中间最大"
      }
    },
    {
      "id": "half",
      "text": "总长正好是半个波长时，天线谐振，能量最容易送进去。",
      "gapAfter": 0.8,
      "beats": {
        "hlf": "半个波长",
        "res": "谐振"
      }
    },
    {
      "id": "mono",
      "text": "砍掉一半，换成一块地平面，就是单极子，四分之一波长。",
      "gapAfter": 0.8,
      "beats": {
        "cut": "砍掉一半",
        "ground": "地平面",
        "monon": "单极子",
        "quarter": "四分之一波长"
      }
    },
    {
      "id": "calc",
      "text": "四百三十三兆赫的波长六十九厘米，单极子只要十六厘米。",
      "caption": "433 MHz 的波长 69 厘米，单极子只要 16 厘米。",
      "gapAfter": 0.8,
      "beats": {
        "wl": "六十九厘米",
        "len": "十六厘米"
      }
    },
    {
      "id": "pattern",
      "text": "天线不会均匀辐射。偶极子的方向图，像一个甜甜圈。",
      "gapAfter": 0.8,
      "beats": {
        "pat": "方向图",
        "donut": "甜甜圈"
      }
    },
    {
      "id": "gain",
      "text": "增益不是放大，是集中：把功率挤到某个方向。",
      "gapAfter": 0.8,
      "beats": {
        "gn": "增益",
        "focus": "集中"
      }
    },
    {
      "id": "pcb",
      "text": "放到电路板上，天线周围要留出净空，别让铜靠近。",
      "gapAfter": 0.7,
      "beats": {
        "clear": "净空",
        "copper": "铜"
      }
    },
    {
      "id": "outro",
      "text": "下面拖动频率，看看天线的长度怎么跟着变。",
      "beats": {
        "drag": "拖动"
      }
    }
  ],
