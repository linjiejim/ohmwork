{
  "voice": "Chinese (Mandarin)_Sincere_Adult",
  "speed": 1,
  "lead": 0.9,
  "gap": 0.5,
  "tail": 1.6,
  "lines": [
    {
      "id": "intro",
      "text": "这一课讲调制：怎么把低频的信息，装到高频的电磁波上。",
      "gapAfter": 0.6
    },
    {
      "id": "why",
      "text": "一千赫的声音信号，波长有三百公里，天线根本做不出来。",
      "caption": "1 kHz 的声音信号，波长有 300 公里，天线根本做不出来。",
      "gapAfter": 0.7,
      "beats": {
        "long": "三百公里",
        "nomake": "做不出来"
      }
    },
    {
      "id": "carrier",
      "text": "办法是让高频的载波，替低频的信息运货。",
      "gapAfter": 0.7,
      "beats": {
        "car": "载波",
        "info": "信息"
      }
    },
    {
      "id": "three",
      "text": "一个正弦波，只有三个参数能改：幅度、频率和相位。",
      "gapAfter": 0.8,
      "beats": {
        "amp": "幅度",
        "freq": "频率",
        "phase": "相位"
      }
    },
    {
      "id": "am",
      "text": "改幅度，就是调幅：载波的包络，跟着信息起伏。",
      "gapAfter": 0.7,
      "beats": {
        "amw": "调幅",
        "env": "包络"
      }
    },
    {
      "id": "fm",
      "text": "改频率，就是调频：幅度不变，信息藏在疏密里。",
      "gapAfter": 0.8,
      "beats": {
        "fmw": "调频",
        "dense": "疏密"
      }
    },
    {
      "id": "dig",
      "text": "数字信号也一样：开关载波、换频率、翻相位。",
      "gapAfter": 0.8,
      "beats": {
        "ask": "开关载波",
        "fsk": "换频率",
        "psk": "翻相位"
      }
    },
    {
      "id": "qam",
      "text": "幅度和相位一起变，一个符号就能装好几个比特。",
      "gapAfter": 0.8,
      "beats": {
        "sym": "符号",
        "bits": "好几个比特"
      }
    },
    {
      "id": "noise",
      "text": "点摆得越密，速率越高，但噪声一大，就容易认错。",
      "gapAfter": 0.8,
      "beats": {
        "denser": "越密",
        "noisy": "噪声",
        "wrong": "认错"
      }
    },
    {
      "id": "shannon",
      "text": "速率的上限，由带宽和信噪比决定，加带宽最划算。",
      "gapAfter": 0.7,
      "beats": {
        "bw": "带宽",
        "snr": "信噪比",
        "cheap": "最划算"
      }
    },
    {
      "id": "outro",
      "text": "下面的实验台，可以切换调制方式，自己看波形。",
      "beats": {
        "drag": "切换"
      }
    }
  ],
