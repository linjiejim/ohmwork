{
  "voice": "Chinese (Mandarin)_Sincere_Adult",
  "speed": 1,
  "lead": 0.9,
  "gap": 0.5,
  "tail": 1.6,
  "lines": [
    {
      "id": "intro",
      "text": "频率高了，一根导线不再只是连接，而是一条传输线。",
      "gapAfter": 0.6
    },
    {
      "id": "delay",
      "text": "二点四吉赫的信号，在六厘米的走线上，同时有波峰和波谷。",
      "caption": "2.4 GHz 的信号，在 6 厘米的走线上，同时有波峰和波谷。",
      "gapAfter": 0.8,
      "beats": {
        "crest": "波峰",
        "trough": "波谷"
      }
    },
    {
      "id": "z0",
      "text": "波前进时，电压和电流有固定的比值，叫特征阻抗。",
      "gapAfter": 0.8,
      "beats": {
        "ratio": "固定的比值",
        "zz": "特征阻抗"
      }
    },
    {
      "id": "fifty",
      "text": "射频最常用五十欧，它是损耗和功率之间的折中。",
      "caption": "射频最常用 50 Ω，它是损耗和功率之间的折中。",
      "gapAfter": 0.8,
      "beats": {
        "fif": "五十欧",
        "loss": "损耗",
        "power": "功率"
      }
    },
    {
      "id": "refl",
      "text": "走到终点，负载和线对不上，多出来的部分就掉头反射。",
      "gapAfter": 0.8,
      "beats": {
        "load": "负载",
        "back": "掉头反射"
      }
    },
    {
      "id": "cases",
      "text": "负载等于五十欧，波全被吸收；开路原样弹回，短路倒着弹回。",
      "caption": "负载等于 50 Ω，波全被吸收；开路原样弹回，短路倒着弹回。",
      "gapAfter": 0.8,
      "beats": {
        "match": "全被吸收",
        "open": "开路",
        "short": "短路"
      }
    },
    {
      "id": "gamma",
      "text": "五十欧的线接一百五十欧，四分之一的功率被反射。",
      "caption": "50 Ω 的线接 150 Ω，四分之一的功率被反射。",
      "gapAfter": 0.8,
      "beats": {
        "r150": "一百五十欧",
        "quarter": "四分之一"
      }
    },
    {
      "id": "three",
      "text": "这件事有三种说法：反射系数、驻波比、回波损耗。",
      "gapAfter": 0.8,
      "beats": {
        "gam": "反射系数",
        "vswr": "驻波比",
        "rl": "回波损耗"
      }
    },
    {
      "id": "net",
      "text": "天线的阻抗对不上时，中间插一个匹配网络，把它调回来。",
      "gapAfter": 0.7,
      "beats": {
        "mnet": "匹配网络"
      }
    },
    {
      "id": "outro",
      "text": "下面拖动负载阻抗，亲眼看反射怎么变。",
      "beats": {
        "drag": "拖动"
      }
    }
  ],
