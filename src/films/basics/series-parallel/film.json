  "lines": [
    {
      "id": "intro",
      "text": "再复杂的电路，连接方式也只有两种：串联和并联。",
      "beats": { "ser": "串联", "par": "并联" },
      "gapAfter": 0.7
    },
    {
      "id": "sA",
      "text": "串联，是首尾相接，电流只有一条路可走。",
      "beats": { "chain": "首尾相接", "one": "一条路" },
      "gapAfter": 0.6
    },
    { "id": "sB", "text": "所以电流处处相同，电压按阻值来分。", "beats": { "same": "处处相同", "split": "按阻值" }, "gapAfter": 0.6 },
    {
      "id": "sC",
      "text": "等效电阻是各电阻相加：一千加两千加三千，就是六千欧。",
      "caption": "等效电阻是各电阻相加：1 k 加 2 k 加 3 k，就是 6 kΩ。",
      "beats": { "sum": "相加", "r1": "一千", "r2": "两千", "r3": "三千", "r6": "六千欧" },
      "gapAfter": 0.8
    },
    {
      "id": "pA",
      "text": "并联，是两端分别接在一起，电流可以分成几条路。",
      "beats": { "ends": "两端", "fork": "几条路" },
      "gapAfter": 0.6
    },
    {
      "id": "pB",
      "text": "每条路的电压相同，电流各走各的，阻值小的走得多。",
      "beats": { "samev": "电压相同", "each": "各走各的", "small": "阻值小" },
      "gapAfter": 0.7
    },
    {
      "id": "pC",
      "text": "总电阻比最小的那只还要小，因为多了一条路。",
      "beats": { "less": "还要小", "extra": "多了一条路" },
      "gapAfter": 0.8
    },
    {
      "id": "trick",
      "text": "口算窍门：两只一样的电阻并联，阻值正好减半。",
      "beats": { "two": "两只", "half": "减半" },
      "gapAfter": 0.8
    },
    {
      "id": "brk",
      "text": "串联断开一处，全都没电；并联断开一只，其他照常。",
      "beats": { "sb": "串联断开", "pb": "并联断开" },
      "gapAfter": 0.7
    },
    { "id": "outro", "text": "下面的实验台，切到并联，看总电阻是不是比最小的还小。", "beats": { "go": "切到并联", "chk": "比最小的还小" } }
  ],
