  "lines": [
    { "id": "intro", "text": "这一课只讲一个公式，它是整门课里用得最多的一个。", "gapAfter": 0.6 },
    {
      "id": "loop",
      "text": "把一只电阻接到电池两端，电压推着电流，从电阻里流过。",
      "beats": { "res": "电阻", "bat": "电池", "push": "电压", "flow": "电流" }
    },
    { "id": "vup", "text": "电压加倍，推得更用力，电流也跟着加倍。", "beats": { "v2": "电压", "i2": "电流" } },
    { "id": "rup", "text": "换成两倍的电阻，路变窄了，电流就只剩一半。", "beats": { "r2": "两倍", "narrow": "路变窄", "ihalf": "电流" }, "gapAfter": 0.7 },
    {
      "id": "law",
      "text": "一八二七年，欧姆把这个关系写成了一个公式：电流，等于电压除以电阻。",
      "caption": "1827 年，欧姆把这个关系写成了一个公式：电流等于电压除以电阻。",
      "beats": { "write": "公式", "lawI": "电流", "lawV": "电压", "lawR": "电阻" },
      "gapAfter": 0.9
    },
    {
      "id": "forms",
      "text": "把公式变一变形，就有三种写法。知道任意两个量，就能求出第三个。",
      "beats": { "three": "三种", "know": "知道", "third": "第三个" },
      "gapAfter": 0.8
    },
    {
      "id": "example",
      "text": "举个例子：五伏的电源，接一只一千欧的电阻，电流就是五毫安。",
      "caption": "举个例子：5 V 的电源，接一只 1 kΩ 的电阻，电流就是 5 mA。",
      "beats": { "exV": "五伏", "exR": "一千欧", "exI": "五毫安" },
      "gapAfter": 0.8
    },
    { "id": "trick", "text": "口算有个窍门：伏特除以千欧，得到的直接就是毫安。", "beats": { "tV": "伏特", "tK": "千欧", "tmA": "毫安" }, "gapAfter": 0.7 },
    {
      "id": "graph",
      "text": "把电压和电流画成图，是一条过原点的直线。电阻越小，线越陡。",
      "beats": { "axes": "画成图", "line": "直线", "steep": "电阻越小" },
      "gapAfter": 0.6
    },
    { "id": "outro", "text": "下面，拖动滑块，自己验证一下。", "beats": { "drag": "拖动" } }
  ],
