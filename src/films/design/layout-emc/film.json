{
  "voice": "Chinese (Mandarin)_Sincere_Adult",
  "speed": 1.0,
  "lead": 0.9,
  "gap": 0.5,
  "tail": 1.6,
  "lines": [
    {
      "id": "intro",
      "text": "同一张原理图，摆法不同，有的安安静静，有的偶尔复位。",
      "gapAfter": 0.6
    },
    {
      "id": "loop",
      "text": "原因在电流回来的那条路：从芯片出去，就一定从地回来。",
      "beats": {
        "out": "出去",
        "back": "回来"
      },
      "gapAfter": 0.7
    },
    {
      "id": "low",
      "text": "低频的时候，回流挑电阻最小的路，在地平面里散开。",
      "beats": {
        "lowW": "低频",
        "spread": "散开"
      },
      "gapAfter": 0.7
    },
    {
      "id": "high",
      "text": "频率一高，回流挑电感最小的路，紧贴在信号线正下方。",
      "beats": {
        "highW": "频率一高",
        "hug": "紧贴"
      },
      "gapAfter": 0.7
    },
    {
      "id": "slotL",
      "text": "地平面要是被槽切断，回流只能绕路，围出的回路面积就变大。",
      "beats": {
        "slot": "槽",
        "detour": "绕路",
        "area": "回路面积"
      },
      "gapAfter": 0.7
    },
    {
      "id": "antL",
      "text": "面积越大，越像天线：向外辐射，也容易被干扰。",
      "beats": {
        "ant": "天线",
        "rad": "辐射",
        "pick": "被干扰"
      },
      "gapAfter": 0.7
    },
    {
      "id": "surgeL",
      "text": "芯片翻转要抽一口电流，电容离得远，走线电感就会顶出电压。",
      "beats": {
        "surge": "抽一口电流",
        "far": "离得远",
        "spike": "顶出电压"
      },
      "gapAfter": 0.7
    },
    {
      "id": "num",
      "text": "十毫米约十纳亨，一百毫安跳变，电源脚上就晃零点二伏。",
      "caption": "10 mm 约 10 nH，100 mA 跳变，电源脚上就晃 0.2 V。",
      "beats": {
        "ten": "十毫米",
        "hund": "一百毫安",
        "vv": "零点二伏"
      },
      "gapAfter": 0.7
    },
    {
      "id": "rules",
      "text": "所以去耦电容要紧贴电源脚，走线短而粗，地端就近打孔。",
      "beats": {
        "close": "紧贴",
        "short": "短而粗",
        "hole": "打孔"
      },
      "gapAfter": 0.7
    },
    {
      "id": "emc",
      "text": "干扰有三要素：干扰源、耦合路径、受害者，去掉一个就解决。",
      "beats": {
        "src": "干扰源",
        "cp": "耦合路径",
        "vic": "受害者",
        "cutit": "去掉"
      },
      "gapAfter": 0.7
    },
    {
      "id": "outro",
      "text": "下面的回流实验，拖动频率，看电流怎么选路。",
      "beats": {
        "try": "回流实验",
        "drag": "拖动"
      }
    }
  ],
