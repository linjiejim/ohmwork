{
  "voice": "Chinese (Mandarin)_Sincere_Adult",
  "speed": 1.0,
  "lead": 0.9,
  "gap": 0.5,
  "tail": 1.6,
  "lines": [
    {
      "id": "intro",
      "text": "这一课，用一个电池供电的温湿度记录器，走一遍设计流程。",
      "gapAfter": 0.6
    },
    {
      "id": "stations",
      "text": "流水线一共七站：需求、框图、选型、原理图、板子、打样、调试。",
      "beats": {
        "s1": "需求",
        "s2": "框图",
        "s3": "选型",
        "s4": "原理图",
        "s5": "板子",
        "s6": "打样",
        "s7": "调试"
      },
      "gapAfter": 0.7
    },
    {
      "id": "reqL",
      "text": "第一站，把需求写成数字：每分钟测一次，电池用满一年，物料三十元。",
      "caption": "第一站，把需求写成数字：每分钟测一次，电池用满一年，物料 30 元。",
      "beats": {
        "req": "需求",
        "min": "每分钟",
        "year": "一年",
        "cost": "三十元"
      },
      "gapAfter": 0.7
    },
    {
      "id": "block",
      "text": "第二站画框图：一个方块一个功能，连线上写清接口。",
      "beats": {
        "blk": "框图",
        "box": "方块",
        "link": "连线"
      },
      "gapAfter": 0.7
    },
    {
      "id": "pick",
      "text": "选型看四样：供货、封装、资料、参考设计。",
      "beats": {
        "pickW": "选型",
        "p1": "供货",
        "p2": "封装",
        "p3": "资料",
        "p4": "参考设计"
      },
      "gapAfter": 0.7
    },
    {
      "id": "power",
      "text": "动手之前先算功耗：醒来干一小会儿活，大部分时间在睡觉。",
      "beats": {
        "pw": "功耗",
        "wake": "醒来",
        "sleep": "睡觉"
      },
      "gapAfter": 0.7
    },
    {
      "id": "life",
      "text": "平均下来约二十二微安，二百二十毫安时的电池，能撑四百多天。",
      "caption": "平均下来约 22 μA，220 mAh 的电池，能撑 400 多天。",
      "beats": {
        "avg": "二十二微安",
        "cap": "二百二十毫安时",
        "days": "四百多天"
      },
      "gapAfter": 0.7
    },
    {
      "id": "led",
      "text": "指示灯要是常亮，续航就只剩几天。",
      "beats": {
        "ledW": "指示灯",
        "few": "几天"
      },
      "gapAfter": 0.7
    },
    {
      "id": "check",
      "text": "原理图画完，照清单检查：电源、去耦、上拉、测试点。",
      "beats": {
        "chk": "清单",
        "c1": "电源",
        "c2": "去耦",
        "c3": "上拉",
        "c4": "测试点"
      },
      "gapAfter": 0.7
    },
    {
      "id": "first",
      "text": "第一次上电，用限流电源，一块一块通电，别直接装电池。",
      "beats": {
        "lim": "限流",
        "one": "一块一块",
        "bat": "装电池"
      },
      "gapAfter": 0.7
    },
    {
      "id": "outro",
      "text": "下面的功耗计算器，拖动唤醒间隔，看续航怎么变。",
      "beats": {
        "calc": "功耗计算器",
        "drag": "拖动"
      }
    }
  ],
