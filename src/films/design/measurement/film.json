{
 "voice": "Chinese (Mandarin)_Sincere_Adult",
 "speed": 1.0,
 "lead": 0.9,
 "gap": 0.5,
 "tail": 1.6,
 "lines": [
  {
   "id": "intro",
   "text": "板子第一次上电就正常，很少见。调试靠仪器，加一套方法。",
   "gapAfter": 0.6
  },
  {
   "id": "vmeas",
   "text": "万用表量电压，表笔并联在两点上，不用断开电路。",
   "beats": {
    "mm": "万用表",
    "par": "并联"
   },
   "gapAfter": 0.7
  },
  {
   "id": "amps",
   "text": "量电流要把回路断开，把表串进去。",
   "beats": {
    "brk": "断开",
    "ser": "串"
   },
   "gapAfter": 0.7
  },
  {
   "id": "short",
   "text": "电流档内阻很小，用它去量电压，等于把电源短路。",
   "beats": {
    "low": "内阻很小",
    "shrt": "短路"
   },
   "gapAfter": 0.7
  },
  {
   "id": "scope",
   "text": "示波器把电压随时间画出来：横向是时间，纵向是电压。",
   "beats": {
    "scp": "示波器",
    "time": "时间",
    "svolt": "电压"
   },
   "gapAfter": 0.7
  },
  {
   "id": "knobs",
   "text": "三组旋钮：时基管横向，档位管纵向，触发让波形停稳。",
   "beats": {
    "tb": "时基",
    "vd": "档位",
    "trig": "触发"
   },
   "gapAfter": 0.7
  },
  {
   "id": "read",
   "text": "数格子读数：一个周期五格，每格二百微秒，就是一千赫。",
   "caption": "数格子读数：一个周期 5 格，每格 200 μs，就是 1 kHz。",
   "beats": {
    "cells": "五格",
    "div": "二百微秒",
    "khz": "一千赫"
   },
   "gapAfter": 0.7
  },
  {
   "id": "probe",
   "text": "探头打到十倍档，接地夹线要短，不然会多出振铃。",
   "caption": "探头打到 ×10 档，接地夹线要短，不然会多出振铃。",
   "beats": {
    "x10": "十倍档",
    "gnd": "接地夹线",
    "ring": "振铃"
   },
   "gapAfter": 0.7
  },
  {
   "id": "logic",
   "text": "调通信总线，用逻辑分析仪：同时录很多路，还能解码成字节。",
   "beats": {
    "la": "逻辑分析仪",
    "dec": "解码"
   },
   "gapAfter": 0.7
  },
  {
   "id": "order",
   "text": "先电源后信号：电压、电流、复位、时钟、下载口、焊接。",
   "beats": {
    "o1": "电压",
    "o2": "电流",
    "o3": "复位",
    "o4": "时钟",
    "o5": "下载口",
    "o6": "焊接"
   },
   "gapAfter": 0.7
  },
  {
   "id": "outro",
   "text": "下面先试万用表：把表笔接到不同的点，看读数。",
   "beats": {
    "try": "万用表",
    "drag": "表笔"
   }
  }
 ],
