  "lines": [
    { "id": "intro", "text": "三极管不只会当开关，用好中间那一段，它还能放大。", "beats": { "amp": "放大" }, "gapAfter": 0.7 },
    { "id": "small", "text": "难处在于，话筒送来的信号太小，三极管根本不理它。", "beats": { "tiny": "信号太小", "ignore": "不理它" }, "gapAfter": 0.7 },
    { "id": "bias", "text": "所以先给基极一个直流电压，叫偏置，让它站到导通的中间。", "beats": { "biasw": "偏置", "mid": "中间" }, "gapAfter": 0.8 },
    { "id": "line", "text": "工作点只能在一条负载线上移动，放在线的中点，摆幅最大。", "beats": { "loadw": "负载线", "mid2": "中点" }, "gapAfter": 0.8 },
    { "id": "clip", "text": "偏得太靠一头，波形就会被削平，这叫失真。", "beats": { "edge": "太靠一头", "clipw": "削平" }, "gapAfter": 0.8 },
    { "id": "re", "text": "再加一只发射极电阻，用负反馈把工作点稳住，不怕温度变化。", "beats": { "rew": "发射极电阻", "stable": "稳住" }, "gapAfter": 0.8 },
    { "id": "gain", "text": "这时增益，约等于集电极电阻，除以发射极电阻。", "beats": { "gainw": "增益", "rcre": "集电极电阻" }, "gapAfter": 0.8 },
    { "id": "cfg", "text": "按信号从哪个脚进出，有共射、共集、共基三种接法。", "beats": { "ce": "共射", "cc": "共集", "cb": "共基" }, "gapAfter": 0.8 },
    { "id": "outro", "text": "下面拖动偏置电压，看波形是怎么被削平的。", "beats": { "drag": "拖动" } }
  ],
