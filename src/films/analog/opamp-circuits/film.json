  "lines": [
    { "id": "intro", "text": "有了虚短和虚断，只要两只电阻，就能搭出各种放大器。", "beats": { "two": "两只电阻" }, "gapAfter": 0.7 },
    { "id": "inv", "text": "先看反相放大器：信号经过一只电阻，接到反相端。", "beats": { "invw": "反相放大器", "rin": "一只电阻" }, "gapAfter": 0.6 },
    { "id": "gnd", "text": "同相端接地，虚短让反相端也成了零伏，叫虚地。", "beats": { "gndw": "接地", "vg": "虚地" }, "gapAfter": 0.6 },
    { "id": "cur", "text": "电流进不了运放，只好全部从反馈电阻流过。", "beats": { "curw": "电流", "rf": "反馈电阻" }, "gapAfter": 0.7 },
    { "id": "gain", "text": "增益就是两只电阻的比值，带一个负号，输出是倒过来的。", "beats": { "gainw": "增益", "neg": "负号", "flip": "倒过来" }, "gapAfter": 0.8 },
    { "id": "non", "text": "同相放大器，信号从同相端直接进去。", "beats": { "nonw": "同相放大器", "direct": "直接" }, "gapAfter": 0.6 },
