  "lines": [
    {
      "id": "intro",
      "text": "板上的接口走不远。线一长，干扰就多，要换一种办法。",
      "beats": { "longW": "线一长", "noiseW": "干扰" },
      "gapAfter": 0.7
    },
    {
      "id": "single",
      "text": "普通信号只用一根线，干扰叠上去，接收端就分不清了。",
      "beats": { "oneW": "一根线", "noise": "干扰", "lost": "分不清" },
      "gapAfter": 0.7
    },
    {
      "id": "diff",
      "text": "差分用两根线，传一对相反的电压，接收端只看两者的差。",
      "beats": { "pair": "一对相反", "sub": "只看两者的差" },
      "gapAfter": 0.7
    },
    {
      "id": "cancel",
      "text": "绞在一起的两根线，受到同样的干扰，相减就抵消了。",
      "beats": { "twist": "绞在一起", "cancelW": "抵消" },
      "gapAfter": 0.8
    },
    {
      "id": "term",
      "text": "线很长，信号会在尽头反射，所以两端各并一只一百二十欧电阻。",
      "caption": "线很长，信号会在尽头反射，所以两端各并一只 120 Ω 电阻。",
      "beats": { "reflect": "反射", "termW": "一百二十欧" },
      "gapAfter": 0.8
    },
    {
      "id": "rs485",
      "text": "R S 四八五，是差分版的串口，一条线上能挂几十个节点。",
      "caption": "RS-485，是差分版的串口，一条线上能挂几十个节点。",
      "beats": { "rsW": "差分版", "nodes": "几十个节点" },
      "gapAfter": 0.8
    },
    {
      "id": "can",
      "text": "CAN 总线用在汽车里，多个节点抢着说话，靠仲裁决定谁先。",
      "beats": { "grab": "抢着说话", "arb": "仲裁" },
      "gapAfter": 0.8
    },
    {
      "id": "usb",
      "text": "U S B 也是一对差分线，电脑是主机，设备只在被问到时回答。",
      "caption": "USB 也是一对差分线，电脑是主机，设备只在被问到时回答。",
      "beats": { "usbW": "差分线", "hostW": "主机", "asked": "被问到" },
      "gapAfter": 0.8
    },
    {
      "id": "choose",
